# Environment variables
#
# Required: NEXT_PUBLIC_WEB_URL — the site's canonical origin.
# - Dev/build/start/e2e load it from `.env.development` (gitignored, local):
#     NEXT_PUBLIC_WEB_URL=http://localhost:3000
# - Vitest loads it from `.env.test` (gitignored, local):
#     NEXT_PUBLIC_WEB_URL=https://example.com
# - Production: set NEXT_PUBLIC_WEB_URL in the deploy environment (required;
#   the build fails without it — `metadataBase` constructs `new URL(WEB_URL)`).
#
# Both local files are gitignored by policy (never commit env files); create
# them from this template when cloning the repo (see scripts in package.json,
# which run every command via `dotenv -e <env-file>`).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
